# Local development only. Copy to .env and replace placeholders.
# Never commit .env or real secrets.

DB_USERNAME=magyen
DB_PASSWORD=change-me

# HMAC-SHA256 signing key. Must be at least 32 characters.
JWT_SECRET=replace-with-a-local-secret-of-at-least-32-chars
JWT_EXPIRATION_MS=3600000

# Optional local bootstrap user (no registration API).
# Set AUTH_BOOTSTRAP_ENABLED=true in local .env to create a development user on startup.
AUTH_BOOTSTRAP_ENABLED=false
AUTH_BOOTSTRAP_USERNAME=local-admin
AUTH_BOOTSTRAP_PASSWORD=change-me
AUTH_BOOTSTRAP_ROLE=ADMIN

# Cloudflare R2 (S3-compatible). Leave blank to disable uploads locally.
# The frontend never uses these values.
MAGYEN_OBJECT_STORAGE_ENDPOINT=
MAGYEN_OBJECT_STORAGE_REGION=us-east-1
MAGYEN_OBJECT_STORAGE_ACCESS_KEY=
MAGYEN_OBJECT_STORAGE_SECRET_KEY=
MAGYEN_OBJECT_STORAGE_BUCKET=
MAGYEN_OBJECT_STORAGE_KEY_PREFIX=local
